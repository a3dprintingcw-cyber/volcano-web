{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "volcano-web",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  // The website files. Anything under /api/ goes to the Worker instead.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // The database (D1, named "volcano" in the Cloudflare account).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "volcano",
      "database_id": "2d67d8a3-26a8-4278-91e4-4408bb0eaf44",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
